package com.herani.ussd_demo.controller;

import com.herani.ussd_demo.dto.LoginResponse;
import com.herani.ussd_demo.dto.TransferRequest;
import com.herani.ussd_demo.dto.TransferResponse;
import com.herani.ussd_demo.service.AuthService;
import com.herani.ussd_demo.service.BankService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
@RestController
@RequestMapping("/ussd")
public class UssdController {

    private final AuthService authService;
    private final BankService bankService;

    @Autowired
    public UssdController(AuthService authService, BankService bankService) {
        this.authService = authService;
        this.bankService = bankService;
    }

    @PostMapping
    public String handleUssd(@RequestParam String sessionId,
                             @RequestParam String phoneNumber,
                             @RequestParam(required = false) String text) {

        String userText = (text == null || text.trim().isEmpty()) ? "" : text.trim();

        System.out.println("=== USSD DEBUG === Text: '" + userText + "' | Parts: " + userText.split("\\*").length);

        // Step 1: First request - Welcome & ask PIN
        if (userText.isEmpty()) {
            return "CON Welcome to SB.\nPlease enter your 6-digit PIN:";
        }

        String[] inputs = userText.split("\\*");

        // Step 2: Only PIN (exactly 1 part) → This is the login step
        if (inputs.length == 1) {
            String pin = inputs[0].trim();

            if (pin.length() != 6 || !pin.matches("\\d{6}")) {
                return "END Invalid PIN. Please enter a 6-digit PIN.";
            }

            LoginResponse loginResponse = authService.authenticateUser(pin, sessionId);
            if (loginResponse.isSuccess()) {
                return "CON 1: My Accounts\n2: Send To SB Account\n3: Send To Other Bank\n4: Send To Wallet\n5: Airtime Top-up\n\n#: Next\n0: Exit";
            } else {
                return "END Login failed: " + loginResponse.getMessage() + ". Please try again.";
            }
        }

        // Step 3: After successful login (at least 2 parts: PIN*choice...)
        if (inputs.length >= 2) {
            String mainChoice = inputs[1].trim();

            // Handle navigation commands
            if ("0".equals(mainChoice)) {
                return "END Thank you for using SB.\nGoodbye!";
            }

            // 1. My Accounts (placeholder for now)
            if ("1".equals(mainChoice)) {
                return "END My Accounts feature coming soon!";
            }

            // 2. Send To SB Account
            if ("2".equals(mainChoice)) {
                if (inputs.length == 2) {
                    // Show sub-menu
                    return "CON Send To SB Account\nEnter destination account number:";
                }
                if (inputs.length == 3) {
                    String subChoice = inputs[2].trim();
                    if ("1".equals(subChoice)) {
                        return "END Account: 1000123456789\n" +
                                "Name: Abebe Kebede\n" +
                                "Balance: ETB 24,850.75\n" +
                                "Available: ETB 24,850.75";
                    }
                    if ("2".equals(subChoice)) {
                        return "END Mini Statement:\n• 12 Apr - Sent 500 ETB\n• 10 Apr + Received 2,000 ETB\n• 08 Apr - Sent 1,200 ETB\n\nCurrent Balance: ETB 24,850.75";
                    }
                    if ("3".equals(subChoice)) {
                        return "CON Main Menu\n1. My Account\n2. Own Account Transfer\n3. Exit";
                    }
                }
                return "END Invalid sub-option in My Account.";
            }

            // 2. Own Account Transfer
            if ("2".equals(mainChoice)) {
                // Check if user is authenticated
                if (!authService.isAuthenticated(sessionId)) {
                    return "END Session expired. Please login again.";
                }
                
                if (inputs.length == 2) {
                    return "CON Own Account Transfer\nEnter destination account number:";
                }
                if (inputs.length == 3) {
                    String toAccount = inputs[2].trim();
                    if (toAccount.length() != 9 || !toAccount.matches("\\d{9}")) {
                        return "END Invalid account number. Please enter 9 digits.";
                    }
                    return "CON Enter amount to transfer:";
                }
                if (inputs.length == 4) {
                    String amountStr = inputs[3].trim();
                    try {
                        double amount = Double.parseDouble(amountStr);
                        if (amount <= 0) {
                            return "END Invalid amount. Please enter a positive number.";
                        }
                        return "CON Confirm transfer:\nTo: " + inputs[2].trim() + "\nAmount: " + amount + " ETB\n1. Confirm\n2. Cancel";
                    } catch (NumberFormatException e) {
                        return "END Invalid amount format. Please enter a valid number.";
                    }
                }
                if (inputs.length == 5) {
                    String confirm = inputs[4].trim();
                    if ("1".equals(confirm)) {
                        // Perform the transfer
                        String toAccount = inputs[2].trim();
                        double amount = Double.parseDouble(inputs[3].trim());
                        String fromAccount = "000000010"; // Default from account
                        
                        TransferRequest transferRequest = new TransferRequest();
                        transferRequest.setFromAccountNo(fromAccount);
                        transferRequest.setToAccountNo(toAccount);
                        transferRequest.setAmount(amount);
                        transferRequest.setRemark("USSD Transfer");
                        
                        String accessToken = authService.getAccessToken(sessionId);
                        TransferResponse transferResponse = bankService.performInternalTransfer(accessToken, transferRequest);
                        
                        if (transferResponse.isSuccess()) {
                            return "END Transfer successful!\nReference: " + 
                                   transferResponse.getData().getReferenceId() + 
                                   "\nStatus: " + transferResponse.getData().getStatus();
                        } else {
                            return "END Transfer failed: " + transferResponse.getMessage();
                        }
                    } else if ("2".equals(confirm)) {
                        return "CON Transfer cancelled.\nMain Menu\n1. My Account\n2. Own Account Transfer\n3. Exit";
                    } else {
                        return "END Invalid option. Transfer cancelled.";
                    }
                }
            }

            // 3. Exit
            if ("3".equals(mainChoice)) {
                return "END Thank you for using Shabelle Bank IBMB.\nGoodbye!";
            }
        }

        return "END Invalid option. Please start again by dialing *123#";
    }
}